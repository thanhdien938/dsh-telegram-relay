# =============================================================================
# DSH Telegram Relay - Environment Configuration Example
# =============================================================================
# Copy this file to .env (or configure variables in GitHub Actions repository vars/secrets)
# NOTE: All values here are safe placeholders. Replace with your deployment values.

# Comma-separated list of GitHub usernames authorized to trigger the relay.
# Fails closed if empty, unset, or set to '*'.
DSH_RELAY_ALLOWED_GITHUB_USERS=your-github-username

# Pinned Telegram target bot username (with or without leading @).
# Issue text cannot override this target.
DSH_RELAY_TELEGRAM_TARGET=your_dsh_bot

# Path or command for telegram-mcp executable.
# Default: telegram-mcp (if available in PATH or runner venv)
DSH_RELAY_TELEGRAM_MCP_EXE=telegram-mcp

# Optional: Path to custom Python executable on self-hosted runner.
# Default: python
DSH_RELAY_PYTHON_EXE=python

# Directory where durable dispatch, result correlation, and identity state JSON files are stored.
# Default: ./state
DSH_RELAY_STATE_DIR=state

# Runner label for self-hosted GitHub Actions runner.
# Default: dsh-relay
DSH_RELAY_RUNNER_LABEL=dsh-relay

# Optional: Path to telegram-mcp session .env file (containing API ID/hash and session credentials).
# If telegram-mcp is configured globally or via working directory, leave blank.
# DSH_RELAY_TELEGRAM_ENV_PATH=/path/to/telegram-mcp/session/.env
